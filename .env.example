# Copy to .env (or export directly) for local development.
# Production secrets live in the host cloud's KMS, never in a checked-in file.

# Postgres DSN. Matches docker-compose.yml defaults.
MERISTEM_DATABASE_URL=postgres://meristem:meristem@localhost:5432/meristem?sslmode=disable

# HTTP listen address for `meristem api`. Default :8080 if unset.
MERISTEM_HTTP_ADDR=:8080
